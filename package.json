		"@eslint/js": "^10.0.1",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.65.0",
		"builtin-modules": "5.4.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"happy-dom": "^21.0.4",
		"js-yaml": "^4.3.2",
		"obsidian": "^1.14.4",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	}
